{# Compiler / language-standard portability layer, shared by every regforge
   header. Tool-namespaced and include-guarded so it is emitted into each
   header but takes effect exactly once per translation unit, however many
   regforge headers are included together. Add a compiler by extending the
   cascades below; standard-driven features need no change. #}
#ifndef REGFORGE_COMPAT_H
#define REGFORGE_COMPAT_H

/* Language standard as a comparable number (0 if not a Standard C compiler). */
#if defined(__STDC_VERSION__)
#  define REGFORGE_STDC __STDC_VERSION__
#else
#  define REGFORGE_STDC 0L
#endif

/* REGFORGE_STATIC_ASSERT(cond, tag, msg) -- compile-time check.
 * C++11+ and C11/C23 have a language construct; older dialects fall back to a
 * negative-array typedef named REGFORGE_ASSERT_<tag>. `tag` must be unique per
 * translation unit -- regforge passes a device-namespaced tag. */
#if defined(__cplusplus) && (__cplusplus >= 201103L)
#  define REGFORGE_STATIC_ASSERT(cond, tag, msg) static_assert(cond, msg)
#elif REGFORGE_STDC >= 201112L
#  define REGFORGE_STATIC_ASSERT(cond, tag, msg) _Static_assert(cond, msg)
#else
#  define REGFORGE_STATIC_ASSERT(cond, tag, msg) \
       typedef char REGFORGE_ASSERT_##tag[(cond) ? 1 : -1]
#endif

/* REGFORGE_INLINE -- inline with internal linkage.
 * `inline` is C99/C++; on C89 degrade to `static`, plus the unused attribute
 * (on compilers that support it) so an unreferenced helper stays warning-free. */
#if defined(__cplusplus) || REGFORGE_STDC >= 199901L
#  define REGFORGE_INLINE static inline
#elif defined(__GNUC__) || defined(__clang__) \
   || defined(__CC_ARM) || defined(__ICCARM__)
#  define REGFORGE_INLINE static __attribute__((unused))
#else
#  define REGFORGE_INLINE static
#endif

#endif /* REGFORGE_COMPAT_H */
