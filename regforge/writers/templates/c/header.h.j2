{{ area("NVIC") }}
{% if has_prio %}
/* An NVIC priority field is 8 bits, MSB-aligned; this core implements the top
 * {{ dev }}_NVIC_PRIO_BITS of them. */
#define {{ dev }}_NVIC_PRIO_BITS ({{ device.cpu.nvic_prio_bits }}U)
#define {{ dev }}_NVIC_PRIO_FIELD_BITS (8U)
#define {{ dev }}_NVIC_PRIO_FIELD_MASK ((1UL << {{ dev }}_NVIC_PRIO_FIELD_BITS) - 1UL)
#define {{ dev }}_IRQ_PRIO_LEVELS (1U << {{ dev }}_NVIC_PRIO_BITS)

/* Align an interrupt priority to this core's implemented bits. NVIC priority
 * registers are MSB-aligned, so the value is shifted into the top
 * {{ device.cpu.nvic_prio_bits }} bit(s); priorities >= the level count truncate in hardware.
 * The range check is an assert: with NDEBUG the helper is the shift alone. */
REGFORGE_INLINE uint8_t {{ ns|lower }}irq_prio(uint8_t priority)
{
    assert(priority < {{ dev }}_IRQ_PRIO_LEVELS);
    return (uint8_t)(priority << ({{ dev }}_NVIC_PRIO_FIELD_BITS - {{ dev }}_NVIC_PRIO_BITS));
}
