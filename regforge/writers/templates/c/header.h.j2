{% set guard = "REGFORGE_" ~ device.name|upper ~ "_H" -%}
{% set dev = device.name|upper -%}
/*
 * {{ device.name }} register definitions.
{% if device.description %}
 * {{ device.description }}
{% endif %}
 *
 * Device:  {{ device.name }}{% if device.vendor %} ({{ device.vendor }}{% if device.series %}, series {{ device.series }}{% endif %}){% endif %}

{% if device.version %}
 * Version: {{ device.version }}
{% endif %}
{% if device.license_text %}
 *
 * Source license (copied from the SVD <licenseText>):
{% for line in device.license_text.split("\n") %}
 *   {{ line }}
{% endfor %}
 *
 * The register definitions generated below carry no license restrictions
 * (CC0-1.0, public domain). Use them freely, including in proprietary
 * firmware, with no attribution or licensing obligation.
{% endif %}
 *
{% if provenance %}
 * Source:  {{ provenance.source_name }}
 * sha256:  {{ provenance.source_sha256 }}
{% for patch in provenance.patches %}
 * Patch:   {{ patch.name }} (sha256: {{ patch.sha256[:16] }})
{% endfor %}
 * Command: {{ provenance.command }}
 * Generated by regforge {{ provenance.tool_version }} -- do not edit.
{% else %}
 * Generated by regforge -- do not edit.
{% endif %}
 */
#ifndef {{ guard }}
#define {{ guard }}

#include <stdint.h>
{% if device.peripherals %}
#include <stddef.h>
{% endif %}
#include <limits.h>
{% if device.cpu and device.cpu.nvic_prio_bits is not none %}
#include <assert.h>
{% endif %}

{% include "compat.h.j2" %}

#define {{ dev }}_ADDRESS_UNIT_BITS {{ device.address_unit_bits }}
REGFORGE_STATIC_ASSERT(CHAR_BIT == {{ dev }}_ADDRESS_UNIT_BITS, {{ dev }}_address_unit_bits,
    "regforge: this header targets {{ device.address_unit_bits }}-bit address units; "
    "the compiler's CHAR_BIT disagrees -- regenerate with a matching emitter mode.");

#define {{ dev }}_BUS_WIDTH {{ device.bus_width }}
{% if device.version %}
#define {{ dev }}_SVD_VERSION "{{ device.version }}"
{% endif %}
{% if provenance %}
#define {{ dev }}_SVD_SHA256 "{{ provenance.source_sha256 }}"
{% endif %}
{% if device.cpu %}
{% set cpu = device.cpu %}

/* CPU ---------------------------------------------------------------------- */
{% if cpu.name %}
#define {{ dev }}_CPU_CORE "{{ cpu.name }}"
{% endif %}
{% if cpu.revision %}
#define {{ dev }}_CPU_REVISION "{{ cpu.revision }}"
{% endif %}
{% if cpu.nvic_prio_bits is not none %}
#define {{ dev }}_NVIC_PRIO_BITS {{ cpu.nvic_prio_bits }}
{% endif %}
{% if cpu.num_interrupts is not none %}
#define {{ dev }}_NUM_IRQS {{ cpu.num_interrupts }}
{% endif %}
{% if cpu.fpu_present is not none %}
#define {{ dev }}_HAS_FPU {{ 1 if cpu.fpu_present else 0 }}
{% endif %}
{% if cpu.mpu_present is not none %}
#define {{ dev }}_HAS_MPU {{ 1 if cpu.mpu_present else 0 }}
{% endif %}
{% if cpu.vtor_present is not none %}
#define {{ dev }}_HAS_VTOR {{ 1 if cpu.vtor_present else 0 }}
{% endif %}
{% if cpu.endian == "little" %}

#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__)
#error "{{ device.name }} is little-endian, but the compiler targets a different byte order."
#endif
{% elif cpu.endian == "big" %}

#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ != __ORDER_BIG_ENDIAN__)
#error "{{ device.name }} is big-endian, but the compiler targets a different byte order."
#endif
{% endif %}
{% if cpu.fpu_present is not none and not cpu.fpu_present %}

#if defined(__ARM_FP) && !{{ dev }}_HAS_FPU
#error "Building with FPU codegen for {{ device.name }}, which has no FPU (check -mfloat-abi / -mfpu)."
#endif
{% endif %}
{% if cpu.nvic_prio_bits is not none %}

#define {{ dev }}_IRQ_PRIO_LEVELS (1U << {{ dev }}_NVIC_PRIO_BITS)

/* Align an interrupt priority to this core's implemented bits. NVIC priority
 * registers are MSB-aligned, so the value is shifted into the top
 * {{ cpu.nvic_prio_bits }} bit(s); priorities >= the level count truncate in hardware. */
REGFORGE_INLINE uint8_t {{ device.name|lower }}_irq_prio(uint8_t priority)
{
    assert(priority < {{ dev }}_IRQ_PRIO_LEVELS);
    return (uint8_t)(priority << (8U - {{ dev }}_NVIC_PRIO_BITS));
}
{% endif %}
{% endif %}

{% for family in families %}
{% set src = family.type_source %}
{% set spf = prefix ~ family.name|upper %}
{% set tname = prefix|lower ~ family.name|lower ~ "_t" %}
{% set members = layout(src) %}
{% set tw = members|map(attribute='type')|map('length')|max %}
{% set fw = members|map(attribute='field')|map('length')|max %}
/* ========================================================================== */
/* {{ family.name }}{% if src.description %} -- {{ src.description }}{% endif %}{% if family.instances|length > 1 %} (family: {{ family.instances|map(attribute='name')|join(', ') }}){% endif %} */

typedef struct {
{% for m in members %}
    {{ "%-*s"|format(tw, m.type) }} {{ "%-*s"|format(fw, m.field) }}  /* 0x{{ "%02X"|format(m.offset) }}{% if m.desc %}  {{ m.desc }}{% endif %} */
{% endfor %}
} {{ tname }};
{% for m in members if m.member %}
REGFORGE_STATIC_ASSERT(offsetof({{ tname }}, {{ m.member }}) == 0x{{ "%02X"|format(m.offset) }}, {{ spf }}_{{ m.member|upper }}_offset, "{{ family.name }}.{{ m.member }} offset");
{% endfor %}
{% for periph in family.instances %}
{% set pf = prefix ~ periph.name|upper %}

/* {{ periph.name }} @ {{ to_bytes(periph.base_address)|hex32 }} */
#define {{ pf }}_BASE ({{ to_bytes(periph.base_address)|hex32 }}UL)
REGFORGE_MAYBE_UNUSED static {{ tname }} *const {{ pf }} = ({{ tname }} *){{ pf }}_BASE;
{% for reg in periph.registers %}

/* {{ periph.name }}.{{ reg.name }}{% if reg.description %} - {{ reg.description }}{% endif %} */
#define {{ pf }}_{{ reg.name|upper }} (*({{ member_type(reg) }} *)({{ pf }}_BASE + {{ to_bytes(reg.address_offset)|hex32 }}UL))
{% if reg.reset_value is not none %}
#define {{ pf }}_{{ reg.name|upper }}_RESET_VALUE ({{ reg.reset_value|hex32 }}UL)
{% endif %}
{% if reg.reset_mask is not none and reg.reset_mask != full_mask(reg.size) %}
#define {{ pf }}_{{ reg.name|upper }}_RESET_MASK ({{ reg.reset_mask|hex32 }}UL)
{% endif %}
{% for field in reg.fields %}
#define {{ pf }}_{{ reg.name|upper }}_{{ field.name|upper }}_Pos ({{ field.bit_offset }}U)
#define {{ pf }}_{{ reg.name|upper }}_{{ field.name|upper }}_Msk ({{ field.mask|hex32 }}UL)
{% for ev in field.enums %}
#define {{ pf }}_{{ reg.name|upper }}_{{ field.name|upper }}_{{ ev.name|upper }} ({{ ev.value }}U)
{% endfor %}
{% endfor %}
{% endfor %}
{% endfor %}

{% endfor %}
#endif /* {{ guard }} */
