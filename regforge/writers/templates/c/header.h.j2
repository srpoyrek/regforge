/* Cortex-M NVIC (fixed-address interrupt controller; emitted only for Cortex-M
 * cores). The register banks live in the System Control Space at addresses ARM
 * fixes for every Cortex-M core and vendor. Each helper takes {{ prefix|lower }}irqn_e --
 * a raw int won't pass -- and bounds-checks against {{ irq_bound }} in debug
 * builds; with NDEBUG each compiles to the bare register access.
 * The geometry is fixed by the architecture: ISER/ICER/ISPR/ICPR hold 32
 * interrupts per word (1 << 5); IPR holds 4 priority fields per word (1 << 2).
 * Shifts and masks rather than divisions, so a -O0 build on a core without a
 * divider stays a few instructions. */
#define {{ dev }}_NVIC_IRQ_WORD_SHIFT (5U)
#define {{ dev }}_NVIC_IRQ_BIT_MASK ((1U << {{ dev }}_NVIC_IRQ_WORD_SHIFT) - 1U)
#define {{ dev }}_NVIC_IPR_WORD_SHIFT (2U)
#define {{ dev }}_NVIC_IPR_SLOT_MASK ((1U << {{ dev }}_NVIC_IPR_WORD_SHIFT) - 1U)
{% set bw = nvic_banks|map(attribute='name')|map('length')|max %}
{% set cw = nvic_banks|map(attribute='purpose')|map('length')|max %}
{% for bank in nvic_banks %}
#define {{ ns|upper }}NVIC_{{ "%-*s"|format(bw, bank.name) }} ((volatile uint32_t *)(uintptr_t)0x{{ "%08X"|format(bank.address) }}UL)  /* {{ "%-*s"|format(cw, bank.purpose) }} */
{% endfor %}

REGFORGE_INLINE void {{ ns|lower }}nvic_enable({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    {{ ns|upper }}NVIC_ISER[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] = 1UL << bit;
}

REGFORGE_INLINE void {{ ns|lower }}nvic_disable({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    {{ ns|upper }}NVIC_ICER[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] = 1UL << bit;
}

REGFORGE_INLINE uint32_t {{ ns|lower }}nvic_get_enabled({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    return (uint32_t)(({{ ns|upper }}NVIC_ISER[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] >> bit) & 1UL);
}

REGFORGE_INLINE void {{ ns|lower }}nvic_set_pending({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    {{ ns|upper }}NVIC_ISPR[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] = 1UL << bit;
}

REGFORGE_INLINE void {{ ns|lower }}nvic_clear_pending({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    {{ ns|upper }}NVIC_ICPR[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] = 1UL << bit;
}

REGFORGE_INLINE uint32_t {{ ns|lower }}nvic_get_pending({{ prefix|lower }}irqn_e irq)
{
    uint32_t bit = (uint32_t)irq & {{ dev }}_NVIC_IRQ_BIT_MASK;
    assert((uint32_t)irq < {{ irq_bound }});
    return (uint32_t)(({{ ns|upper }}NVIC_ISPR[(uint32_t)irq >> {{ dev }}_NVIC_IRQ_WORD_SHIFT] >> bit) & 1UL);
}
{% if device.cpu.nvic_prio_bits is not none %}

REGFORGE_INLINE void {{ ns|lower }}nvic_set_priority({{ prefix|lower }}irqn_e irq, uint8_t priority)
{
    volatile uint32_t *ipr = &{{ ns|upper }}NVIC_IPR[(uint32_t)irq >> {{ dev }}_NVIC_IPR_WORD_SHIFT];
    uint32_t shift = ((uint32_t)irq & {{ dev }}_NVIC_IPR_SLOT_MASK) * {{ dev }}_NVIC_PRIO_FIELD_BITS;
    assert((uint32_t)irq < {{ irq_bound }});
    *ipr = (*ipr & ~({{ dev }}_NVIC_PRIO_FIELD_MASK << shift))
         | ((uint32_t){{ ns|lower }}irq_prio(priority) << shift);
}

REGFORGE_INLINE uint8_t {{ ns|lower }}nvic_get_priority({{ prefix|lower }}irqn_e irq)
{
    const volatile uint32_t *ipr = &{{ ns|upper }}NVIC_IPR[(uint32_t)irq >> {{ dev }}_NVIC_IPR_WORD_SHIFT];
    uint32_t shift = ((uint32_t)irq & {{ dev }}_NVIC_IPR_SLOT_MASK) * {{ dev }}_NVIC_PRIO_FIELD_BITS;
    assert((uint32_t)irq < {{ irq_bound }});
    return (uint8_t)(((*ipr >> shift) & {{ dev }}_NVIC_PRIO_FIELD_MASK)
                     >> ({{ dev }}_NVIC_PRIO_FIELD_BITS - {{ dev }}_NVIC_PRIO_BITS));
}
