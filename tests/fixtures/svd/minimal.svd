<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.3">
  <vendor>DemoCorp</vendor>
  <name>DemoMCU</name>
  <series>DemoSeries</series>
  <version>1.0</version>
  <headerDefinitionsPrefix>DC_</headerDefinitionsPrefix>
  <description>Minimal demo device used by the regforge test suite</description>
  <licenseText>
Copyright (c) 2024 DemoCorp.
Licensed under the Apache License, Version 2.0.
  </licenseText>
  <cpu>
    <name>CM0PLUS</name>
    <revision>r0p1</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <vtorPresent>1</vtorPresent>
    <nvicPrioBits>2</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
    <deviceNumInterrupts>32</deviceNumInterrupts>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>GPIOA</name>
      <description>General purpose I/O port A</description>
      <baseAddress>0x40020000</baseAddress>
      <!-- addressBlock larger than the last register (ODR ends at 0x18): the
           struct is padded to 0x20 and sizeof is asserted == 0x20. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MODER</name>
          <description>Mode register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <!-- A field template: MODE%s with dim 2, 2 bits apart, expands to
                 MODE0 and MODE1: ordinary fields, each with the enums. -->
            <field>
              <dim>2</dim>
              <dimIncrement>2</dimIncrement>
              <name>MODE%s</name>
              <description>Pin mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue><name>INPUT</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>OUTPUT</name><value>1</value></enumeratedValue>
                <enumeratedValue><name>ALTERNATE</name><value>2</value></enumeratedValue>
                <enumeratedValue><name>ANALOG</name><value>3</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IDR</name>
          <description>Input data register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>ODR</name>
          <description>Output data register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          <fields>
            <!-- A field array: OD[%s] with dim 16, 1 bit apart, stays one field
                 and emits indexed _Pos(i) / _Msk(i) macros plus a _COUNT. -->
            <field>
              <dim>16</dim>
              <dimIncrement>1</dimIncrement>
              <name>OD[%s]</name>
              <description>Port output data bit</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <description>Universal async receiver/transmitter</description>
      <groupName>UART</groupName>
      <baseAddress>0x40004000</baseAddress>
      <!-- addressBlock exactly fits the registers (DR, SR end at 0x08): no
           padding. Inherited by UART1 (derived). -->
      <addressBlock>
        <offset>0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <!-- A buffer window right after the registers: the vendor names no
           registers for a FIFO, so the struct gets one raw array (BUFFER0)
           rather than invented member names. Extends the size contract to
           0x28, and rides the derivedFrom copy into UART1. -->
      <addressBlock>
        <offset>0x8</offset>
        <size>0x20</size>
        <usage>buffer</usage>
      </addressBlock>
      <interrupt>
        <name>UART0</name>
        <description>UART0 global interrupt</description>
        <value>20</value>
      </interrupt>
      <registers>
        <register>
          <name>DR</name>
          <description>Data register</description>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <name>SR</name>
          <description>Status register</description>
          <addressOffset>0x04</addressOffset>
          <access>read-only</access>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <description>UART, instance 1</description>
      <baseAddress>0x40004400</baseAddress>
      <!-- A derived peripheral declares its OWN interrupt: it is per-instance,
           not inherited from the base (UART1 has vector 21, not UART0's 20). -->
      <interrupt>
        <name>UART1</name>
        <description>UART1 global interrupt</description>
        <value>21</value>
      </interrupt>
    </peripheral>
    <!-- Shared vector: SPI0 and SPI1 land on ONE NVIC slot (a combined SPI IRQ,
         as pin-limited packages do); distinct interrupt names, same value 30.
         One handler fires for both, so the ISR must demux. This is a shared
         vector (same number, different addresses), not same-address
         alternatePeripheral. -->
    <peripheral>
      <name>SPI0</name>
      <description>Serial peripheral interface</description>
      <groupName>SPI</groupName>
      <baseAddress>0x40008000</baseAddress>
      <!-- The pad-to-block case: SPI0 and SPI1 sit 0x400 apart, so padding the
           struct to the block makes sizeof equal the hardware stride and an array
           over the instances index correctly. The other peripherals keep tight
           blocks so the golden stays readable. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI0</name>
        <description>SPI0 interrupt</description>
        <value>30</value>
      </interrupt>
      <registers>
        <register><name>CR</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
        <register><name>DR</name><description>Data register</description><addressOffset>0x04</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPI1</name>
      <description>Serial peripheral interface</description>
      <groupName>SPI</groupName>
      <baseAddress>0x40008400</baseAddress>
      <!-- Must match SPI0's block exactly: they share one emitted type. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI1</name>
        <description>SPI1 interrupt</description>
        <value>30</value>
      </interrupt>
      <registers>
        <register><name>CR</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
        <register><name>DR</name><description>Data register</description><addressOffset>0x04</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM1</name>
      <description>Advanced timer</description>
      <!-- Its own groupName: the advanced timer has an extra RCR, so labelling
           it TIM alongside TIM2/TIM3 would be the vendor claiming one type for
           two layouts. That divergence case lives in lint_demo.svd. -->
      <groupName>TIM1</groupName>
      <baseAddress>0x40010000</baseAddress>
      <!-- Advanced timer: its own type (extra RCR), still a 0x400 footprint. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <!-- A peripheral with several interrupt lines, each its own vector: the
           enum lists both, named after the interrupt (not the peripheral). -->
      <interrupt>
        <name>TIM1_UP</name>
        <description>TIM1 update</description>
        <value>25</value>
      </interrupt>
      <interrupt>
        <name>TIM1_BRK</name>
        <description>TIM1 break</description>
        <value>26</value>
      </interrupt>
      <registers>
        <register><name>CR1</name><description>Control register 1</description><addressOffset>0x00</addressOffset></register>
        <register><name>ARR</name><description>Auto-reload register</description><addressOffset>0x04</addressOffset></register>
        <register><name>RCR</name><description>Repetition counter (advanced only)</description><addressOffset>0x08</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM2</name>
      <description>General-purpose timer</description>
      <groupName>TIM</groupName>
      <baseAddress>0x40000000</baseAddress>
      <!-- Instances sit 0x400 apart; padding to the block makes the struct stride match, so an array over TIM2/TIM3 indexes correctly. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register><name>CR1</name><description>Control register 1</description><addressOffset>0x00</addressOffset></register>
        <register><name>ARR</name><description>Auto-reload register</description><addressOffset>0x04</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM3</name>
      <description>General-purpose timer</description>
      <groupName>TIM</groupName>
      <baseAddress>0x40000400</baseAddress>
      <!-- Must match TIM2's block exactly: they share one emitted type. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register><name>CR1</name><description>Control register 1</description><addressOffset>0x00</addressOffset></register>
        <register><name>ARR</name><description>Auto-reload register</description><addressOffset>0x04</addressOffset></register>
      </registers>
    </peripheral>
    <!-- derivedFrom WITHOUT groupName: merge, type named after the root (ADC0).
         Also the interrupt-inheritance case: ADC0 has a vector, ADC1 (derived)
         declares none. An interrupt is per-instance, so regforge does NOT copy
         ADC0's vector onto ADC1, and ADC1 emits no _IRQ (see the header). Per SVD
         spec ADC1 would silently inherit ADC0's vector (two peripherals, one
         slot); check_derived_interrupts warns to declare ADC1's own. -->
    <peripheral>
      <name>ADC0</name>
      <!-- headerStructName: the vendor naming the generated struct. Without it
           the type is named after the root instance (dc_adc0_t) because this
           pair has no groupName; with it the family is ADC -> dc_adc_t. ADC1
           inherits it through derivedFrom, as nRF relies on. -->
      <headerStructName>ADC</headerStructName>
      <description>Analog-to-digital converter</description>
      <baseAddress>0x40012000</baseAddress>
      <!-- Inherited verbatim by ADC1 (derivedFrom), so both are sized identically. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ADC0</name>
        <description>ADC0 conversion complete</description>
        <value>27</value>
      </interrupt>
      <registers>
        <register><name>CR</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
        <register><name>DR</name><description>Data register</description><addressOffset>0x04</addressOffset><access>read-only</access></register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="ADC0">
      <name>ADC1</name>
      <description>ADC, instance 1</description>
      <baseAddress>0x40012400</baseAddress>
      <!-- Declares its own vector: interrupts are per-instance and regforge
           never inherits them across derivedFrom. The omission case (a derived
           peripheral with no vector of its own) lives in lint_demo.svd. -->
      <interrupt>
        <name>ADC1</name>
        <description>ADC1 conversion complete</description>
        <value>28</value>
      </interrupt>
    </peripheral>
    <!-- derivedFrom but the derived peripheral ADDS a register: layouts differ, so
         "same type" would be a lie -> regforge splits them. -->
    <peripheral>
      <name>WDT0</name>
      <description>Watchdog timer</description>
      <baseAddress>0x40013000</baseAddress>
      <!-- Smallest register set on the chip (0x4) against a 0x400 block: the widest pad-to-block case. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register><name>CR</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="WDT0">
      <name>WDT1</name>
      <description>Watchdog, instance 1 (adds a reload register)</description>
      <baseAddress>0x40013400</baseAddress>
      <!-- registers window plus an explicit reserved range: the reserved block
           contributes padding only, never a named member, and still extends the
           size contract to 0x400. -->
      <addressBlock>
        <offset>0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x8</offset>
        <size>0x8</size>
        <usage>reserved</usage>
      </addressBlock>
      <registers>
        <register><name>CR</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
        <register><name>RELOAD</name><description>Reload value</description><addressOffset>0x04</addressOffset></register>
      </registers>
    </peripheral>
    <!-- Type-name collision: groupName equals the only instance's
         name, so the type is already spelled after it and no self-alias is
         emitted (redefining a typedef is an error before C11). -->
    <peripheral>
      <name>CRC</name>
      <description>Cyclic redundancy check</description>
      <groupName>CRC</groupName>
      <baseAddress>0x40014000</baseAddress>
      <addressBlock><offset>0</offset><size>0x8</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>DR</name><description>Data register</description><addressOffset>0x00</addressOffset></register>
      </registers>
    </peripheral>
    <!-- Peripheral array (<dim> on a peripheral): one template, two instances
         0x100 apart, labelled A and B by dimIndex. The copies form one family
         (the pattern stem PWM stands in for the missing groupName), so one
         dc_pwm_t with DC_PWMA / DC_PWMB pointers is emitted. Inside: CC[%s] is
         a packed register array (one member CC[4] plus an indexed macro), and
         DT%s is two separately placed registers 8 bytes apart; the hole
         between them is padding, so it could not be a C array. -->
    <peripheral>
      <dim>2</dim>
      <dimIncrement>0x100</dimIncrement>
      <dimIndex>A,B</dimIndex>
      <name>PWM%s</name>
      <description>Pulse-width modulator</description>
      <baseAddress>0x40015000</baseAddress>
      <addressBlock><offset>0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>CTRL</name><description>Control register</description><addressOffset>0x00</addressOffset></register>
        <register>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <name>CC[%s]</name>
          <description>Capture/compare channel</description>
          <addressOffset>0x10</addressOffset>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>8</dimIncrement>
          <name>DT%s</name>
          <description>Dead time</description>
          <addressOffset>0x20</addressOffset>
        </register>
      </registers>
    </peripheral>
    <!-- Clusters: CH[%s] is an array of four channel blocks 0x10 apart (a
         nested dc_dma_ch_t, padded to the stride and size-asserted, used as one
         member CH[4]), and STAT is a single cluster: its own type, one member,
         no size assert because the source declares no stride for it. -->
    <peripheral>
      <name>DMA</name>
      <description>Direct memory access</description>
      <baseAddress>0x40016000</baseAddress>
      <addressBlock><offset>0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>CFG</name><description>Global configuration</description><addressOffset>0x00</addressOffset></register>
        <cluster>
          <dim>4</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>CH[%s]</name>
          <description>DMA channel</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>CTRL</name><description>Channel control</description><addressOffset>0x0</addressOffset>
            <fields>
              <field><name>EN</name><description>Channel enable</description><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
            </fields>
          </register>
          <register><name>SRC</name><description>Source address</description><addressOffset>0x4</addressOffset></register>
          <register><name>DST</name><description>Destination address</description><addressOffset>0x8</addressOffset></register>
        </cluster>
        <cluster>
          <name>STAT</name>
          <description>Status block</description>
          <addressOffset>0x50</addressOffset>
          <register><name>FLAGS</name><description>Channel flags</description><addressOffset>0x0</addressOffset><access>read-only</access></register>
          <register><name>ERR</name><description>Error flags</description><addressOffset>0x4</addressOffset><access>read-only</access></register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
  <vendorExtensions>
    <democorp:tuning xmlns:democorp="urn:democorp:svd">calibrated</democorp:tuning>
  </vendorExtensions>
</device>
