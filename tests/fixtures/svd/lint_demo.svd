<?xml version="1.0" encoding="utf-8"?>
<!-- A deliberately-flawed device: every peripheral trips a regforge consistency
     check, so the linter's flagging is exercised end to end. Run
     `regforge tests/fixtures/svd/lint_demo.svd -v` to see the warnings/errors in
     colour; tests/check/test_lint_demo.py locks the exact findings and the
     emitted header. This is NOT a well-formed chip; minimal.svd is the clean
     reference. Note: no device-level <access>, so a register that omits it warns. -->
<device schemaVersion="1.3">
  <vendor>DemoCorp</vendor>
  <name>LintDemo</name>
  <headerDefinitionsPrefix>LD_</headerDefinitionsPrefix>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <!-- Cross-peripheral overlap (ERROR): UART's block [0x40004000, 0x40004400)
         and TIMER's, starting at 0x40004200, claim the same bytes. -->
    <peripheral>
      <name>UART</name>
      <baseAddress>0x40004000</baseAddress>
      <addressBlock><offset>0</offset><size>0x400</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>DR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER</name>
      <baseAddress>0x40004200</baseAddress>
      <addressBlock><offset>0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Register outside its block (WARNING): FLASH declares a 0x20 block but FAR
         sits at 0x40. The struct floor-asserts sizeof == 0x44 (block below regs). -->
    <peripheral>
      <name>FLASH</name>
      <baseAddress>0x40010000</baseAddress>
      <addressBlock><offset>0</offset><size>0x20</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>FAR</name><addressOffset>0x40</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Intra-peripheral block overlap (WARNING): DMA's two blocks intersect. -->
    <peripheral>
      <name>DMA</name>
      <baseAddress>0x40020000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x20</size><usage>registers</usage></addressBlock>
      <addressBlock><offset>0x10</offset><size>0x20</size><usage>buffer</usage></addressBlock>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Unowned padding (WARNING): FIFO's block claims only 0x0..0x100, but
         DATA sits at 0x2000. The struct must pad across the hole to place DATA
         at the right offset, so regforge emits ~0x1F00 bytes of RESERVED over
         space the peripheral never claimed; esp32's UART does this at
         0x200C0000. The padding is still emitted (the offsets are correct);
         the check says the claim is invented. -->
    <peripheral>
      <name>FIFO</name>
      <baseAddress>0x40040000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>DATA</name><addressOffset>0x2000</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Access unspecified at every level (WARNING from the resolve pass): REG
         declares no <access> and there is no device/peripheral default. -->
    <peripheral>
      <name>MISC</name>
      <baseAddress>0x40030000</baseAddress>
      <registers>
        <register><name>REG</name><addressOffset>0x0</addressOffset><size>32</size></register>
      </registers>
    </peripheral>
    <!-- Namesake split (WARNING): FPU and FPU_CPACR both claim groupName FPU
         with different layouts. Two types are emitted, and the peripheral
         literally named FPU takes the plain name; without that rule the outlier
         is named after itself, which IS the group name, and both typedefs
         collide. Real shape from STM32F7. -->
    <peripheral>
      <name>FPU_CPACR</name>
      <groupName>FPU</groupName>
      <baseAddress>0x40050000</baseAddress>
      <registers>
        <register><name>CPACR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FPU</name>
      <groupName>FPU</groupName>
      <baseAddress>0x40051000</baseAddress>
      <registers>
        <register><name>FPCCR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>FPCAR</name><addressOffset>0x4</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Divergent groupName (WARNING), moved off the clean fixture: TIMER_ADV
         carries an extra RCR while sharing groupName TMR with TMR0, so the
         label is not one verified type. -->
    <peripheral>
      <name>TMR0</name>
      <groupName>TMR</groupName>
      <baseAddress>0x40052000</baseAddress>
      <registers>
        <register><name>CR1</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER_ADV</name>
      <groupName>TMR</groupName>
      <baseAddress>0x40053000</baseAddress>
      <registers>
        <register><name>CR1</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>RCR</name><addressOffset>0x4</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- Derived peripheral with no vector of its own (WARNING), moved off the
         clean fixture: per SVD spec ADCB would silently inherit ADCA's vector
         (two peripherals, one slot). regforge does not inherit, so it warns. -->
    <peripheral>
      <name>ADCA</name>
      <baseAddress>0x40054000</baseAddress>
      <interrupt><name>ADCA</name><value>40</value></interrupt>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="ADCA">
      <name>ADCB</name>
      <baseAddress>0x40055000</baseAddress>
    </peripheral>
    <!-- Dimmed peripheral with an interrupt (WARNING from the expand pass):
         <dim> cannot shift a vector number, so both copies of TMRX%s land on
         vector 41; the template declares it for each, but it is reported and
         the header notes the shared vector at both instances. -->
    <peripheral>
      <dim>2</dim>
      <dimIncrement>0x100</dimIncrement>
      <name>TMRX%s</name>
      <baseAddress>0x40056000</baseAddress>
      <interrupt><name>TMRX%s</name><value>41</value></interrupt>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <!-- dimIndex on an array (WARNING): CH[%s] elements are indexed 0..1 by the
         language, so the labels A,B name nothing and are ignored. Cluster
         derivedFrom (WARNING): not resolved yet, so EXTRA is emitted as written;
         it carries its own registers, since an empty cluster has no element
         to lay out. -->
    <peripheral>
      <name>DMAX</name>
      <baseAddress>0x40057000</baseAddress>
      <registers>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x10</dimIncrement>
          <dimIndex>A,B</dimIndex>
          <name>CH[%s]</name>
          <addressOffset>0x0</addressOffset>
          <register><name>CTRL</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        </cluster>
        <cluster derivedFrom="CH">
          <name>EXTRA</name>
          <addressOffset>0x20</addressOffset>
          <register><name>CTRL</name><addressOffset>0x0</addressOffset><size>32</size><access>read-write</access></register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>
